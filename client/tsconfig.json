{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    // Metro resolves `./foo` to `foo.ios.tsx` / `foo.native.ts`; TypeScript and
    // eslint-plugin-import need to be told about those suffixes too.
    "moduleSuffixes": [
      ".ios",
      ".native",
      ""
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
