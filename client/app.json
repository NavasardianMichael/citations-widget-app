{
  "expo": {
    "name": "Մեջբերումներ Աստվածաշնչից",
    "slug": "citations-widget-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "citationswidget",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.citationswidgetapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbf9f8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.citationswidgetapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "citationswidget"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidWorkManagerAlign",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo modules are resolved/instantiated via reflection by expo-modules-core\n-keep class expo.modules.** { *; }\n-keep interface expo.modules.** { *; }\n# @expo/ui references optional Jetpack Compose classes on some codepaths that\n# aren't present in this build variant's classpath (e.g. expo.modules.kotlin.types.ColorCompat).\n# They're compile-time-optional, not runtime-missing, so silence R8's missing-class check.\n-dontwarn expo.modules.**\n\n# react-native-android-widget: widget provider/receiver classes are instantiated\n# by the Android AppWidget framework via reflection (declared in AndroidManifest).\n-keep class com.reactnativeandroidwidget.** { *; }\n-keep class * extends android.appwidget.AppWidgetProvider { *; }\n\n# Sentry: keep SDK classes so ProGuard mapping stays useful and crash reports\n# keep symbolicating after obfuscation.\n-keep class io.sentry.** { *; }\n-dontwarn io.sentry.**"
          }
        }
      ],
      "expo-dev-client",
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf9f8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.anonymous.citationswidgetapp.widgets",
          "groupIdentifier": "group.com.anonymous.citationswidgetapp",
          "widgets": [
            {
              "name": "CitationWidget",
              "displayName": "Մեջբերումներ Աստվածաշնչից",
              "description": "Մեջբերումներ ձեր գլխավոր էկրանին",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "systemExtraLarge",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ],
      "./plugins/withAndroidWidgetResize",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/widget-glyphs/WidgetGlyphs.ttf",
            "./assets/fonts/vrdznagir/Vrdznagir.otf",
            "./assets/fonts/braind-amanor/BraindAmanor.otf",
            "./assets/fonts/artsakh/Artsakh.otf",
            "./assets/fonts/davel-aghvor/davel-aghvor.otf",
            "./assets/fonts/mardoto/Mardoto-Regular.ttf",
            "./assets/fonts/arti/Arti-Regular.otf",
            "./assets/fonts/arian-grqi/Arian_Grqi_U.ttf",
            "./assets/fonts/braind-zbans/BraindZbans.otf",
            "./assets/fonts/nortar-body/NorTarBody.otf",
            "./assets/fonts/arm-hmks-script/ArmHmksScript.ttf",
            "./assets/fonts/noyemi/Noyemi.otf",
            "./assets/fonts/armeniapedia-garun/ArmeniapediaGarun.ttf",
            "./assets/fonts/armeniapedia-geghagrutyun/ArmeniapediaGeghagrutyun.ttf",
            "./assets/fonts/sasuntsi/Sasuntsi-Regular.ttf",
            "./assets/fonts/armeniapedia-jhapaven/ArmeniapediaJhapaven.ttf"
          ],
          "widgets": [
            {
              "name": "CitationWidget",
              "label": "Թվային սրբարան · 4×4",
              "description": "Մեջբերում ձեր գլխավոր էկրանին (4×4)",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CitationWidgetCompact",
              "label": "Թվային սրբարան · 4×3",
              "description": "Կոմպակտ մեջբերում ձեր գլխավոր էկրանին (4×3)",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CitationWidgetLarge",
              "label": "Թվային սրբարան · 4×5",
              "description": "Մեծ մեջբերում ձեր գլխավոր էկրանին (4×5)",
              "minWidth": "250dp",
              "minHeight": "320dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "owner": "michael.navasardyan",
    "extra": {
      "eas": {
        "projectId": "9160cf46-3fa2-462c-8970-508420d5b806"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
