    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.10",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
