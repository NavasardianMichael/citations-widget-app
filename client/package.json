  "scripts": {
    "eas-build-pre-install": "npm ci --prefix ../shared",
    "postinstall": "patch-package",
    "start": "powershell -ExecutionPolicy Bypass -File ./run-start.ps1",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "powershell -ExecutionPolicy Bypass -File ./run-android.ps1",
    "android:apk": "powershell -ExecutionPolicy Bypass -File ./run-android-apk.ps1",
    "android:start": "expo start --android --dev-client",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify:widget": "node ./scripts/verify-ios-widget-layout.js",
    "analyze": "powershell -ExecutionPolicy Bypass -File ./run-analyze.ps1",
    "analyze:export": "powershell -ExecutionPolicy Bypass -File ./run-analyze-export.ps1"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [".*"]
      }
    }
  },
  "allowScripts": {
    "@sentry/cli@2.58.4": true
  }
